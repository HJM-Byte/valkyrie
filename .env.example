# 复制为 robot/.env 后填自己的 Key；这个文件不要提交、不要发出去。
# .env 已被 .gitignore 排除。

# 必填：阿里云百炼（Qwen3.8-Flash）或任何 OpenAI 兼容服务的 Key
DASHSCOPE_API_KEY=

# 可选：BreezeBlue 寒蝉余音（手机/桌面 TTS）
# 不填时自动退 edge-tts，再退本地 VITS；Key 不要提交到仓库
# BREEZE_API_KEY=
# BREEZE_VOICE_ID=voc_wkzpcy2xxwch

# 可选：换模型 / 换网关（一般不用改）
# ROBOT_LLM_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# ROBOT_LLM_MODEL=qwen3.8-flash
# ROBOT_LLM_KEY_ENV=DASHSCOPE_API_KEY

# 可选：模型目录。默认 robot\models；建议放在纯 ASCII 路径。
# 本机示例：C:\valkyrie-models
# ROBOT_MODELS=

# 可选：数据目录。默认 robot\data；记忆、日志、人脸底库都在这里。
# ROBOT_DATA=

# 可选：她的名字（默认瓦尔基里）
# ROBOT_NAME=瓦尔基里

# 可选：手机/网页服务在局域网开放时的访问口令
# VALKYRIE_APP_TOKEN=换成一串随机字符

# 可选：本地 TTS 开关（默认 1）
# ROBOT_TTS_LOCAL=1

# 可选：主动消息节奏。off 保持原行为；shadow 只记录；enforced 才真正收紧。
# 等级：essential 只保留必要事项；low 默认低频；normal 保留更多主动意图。
# ROBOT_PROACTIVE_PACING_MODE=enforced
# ROBOT_PROACTIVE_LEVEL=low
# ROBOT_PROACTIVE_MIN_INTERVAL_MINUTES=180
# ROBOT_PROACTIVE_NONESSENTIAL_DAILY_CEILING=3
# ROBOT_PROACTIVE_POST_USER_GRACE_MINUTES=60
# ROBOT_PROACTIVE_FIRST_UNANSWERED_BACKOFF_MINUTES=720
# ROBOT_PROACTIVE_REPEATED_UNANSWERED_BACKOFF_MINUTES=1440
